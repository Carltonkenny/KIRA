# KIRA Backend Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# -------------------------------------------
# Server
# -------------------------------------------
ENVIRONMENT=development
PORT=8090

# -------------------------------------------
# CORS — comma-separated list of allowed origins
# Add your Vercel/Railway production URLs here
# -------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------
# LLM — DeepSeek (default) or any OpenAI-compatible endpoint
# Get your key at: https://platform.deepseek.com
# -------------------------------------------
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# -------------------------------------------
# Memory — Mem0 Cloud (optional)
# If not set, KIRA falls back to local SQLite automatically.
# Get your key at: https://app.mem0.ai
# -------------------------------------------
MEM0_API_KEY=your-mem0-api-key-here
