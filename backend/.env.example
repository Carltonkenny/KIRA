# KIRA Backend Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# -------------------------------------------
# Server
# -------------------------------------------
ENVIRONMENT=development
PORT=8090

# -------------------------------------------
# CORS — comma-separated list of allowed origins
# Add your Vercel/Firebase production URLs here
# -------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------
# LLM Provider (Primary: Groq LPU — sub-500ms inference)
# Get your free key at: https://console.groq.com
# -------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------
# LLM Fallback (Optional: DeepSeek — activates if Groq rate-limited)
# Get your key at: https://platform.deepseek.com
# -------------------------------------------
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# -------------------------------------------
# Database — Neon Serverless PostgreSQL (Production)
# Sign up free at: https://neon.tech
# If not set, KIRA falls back to local SQLite automatically.
# -------------------------------------------
DATABASE_URL=postgresql://username:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------
# Mem0 Cloud (Optional — legacy, Neon pgvector is preferred)
# -------------------------------------------
# MEM0_API_KEY=your-mem0-api-key-here
